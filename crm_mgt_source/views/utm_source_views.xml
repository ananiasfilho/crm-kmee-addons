<odoo>
    <!-- Ação para abrir a lista dos Marketing Sources -->
    <record id="action_utm_source" model="ir.actions.act_window">
        <field name="name">MKT Sources</field>
        <field name="res_model">utm.source</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <!-- Vista de Lista (Tree) para o modelo utm.source -->
    <record id="view_utm_source_tree" model="ir.ui.view">
        <field name="name">utm.source.tree</field>
        <field name="model">utm.source</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
</odoo>
